FROM oven/bun:1.4.0 AS build
WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile
COPY . .
RUN DATABASE_URL=postgresql://build:build@localhost/build bun run build

FROM oven/bun:1.4.0-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/.furin/build/bun/server ./server
COPY --from=build /app/.furin/build/bun/server-codec.js ./server-codec.js
COPY --from=build /app/public ./public
EXPOSE 3000
CMD ["./server"]
