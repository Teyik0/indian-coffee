{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/react"],
  "files": {
    "includes": ["!.furin", "!furin-env.d.ts", "!public", "!src/db/migrations"]
  },
  "assist": {
    "actions": {
      "source": {
        "useSortedKeys": "off"
      }
    }
  },
  "linter": {
    "rules": {
      "performance": {
        "noBarrelFile": "off",
        "noJsxPropsBind": "off",
        "noNamespaceImport": "off"
      }
    }
  },
  "javascript": {
    "globals": ["Bun"]
  },
  "overrides": [
    {
      "includes": ["src/components/ui/calendar.tsx"],
      "linter": {
        "rules": {
          "correctness": {
            "noNestedComponentDefinitions": "off"
          },
          "suspicious": {
            "noShadow": "off"
          }
        }
      }
    },
    {
      "includes": ["src/styles/admin.css"],
      "linter": {
        "rules": {
          "style": {
            "noDescendingSpecificity": "off"
          }
        }
      }
    },
    {
      "includes": ["src/components/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@/db": "Les pages et composants passent par un module API, jamais directement par la base.",
                  "drizzle-orm": "Utilisez l’adaptateur @/api/lib/db.",
                  "resend": "Utilisez l’adaptateur @/api/lib/resend.",
                  "uploadthing": "Utilisez l’adaptateur @/api/lib/uploadthing."
                },
                "patterns": [
                  {
                    "group": ["@/db/**"],
                    "message": "Les pages et composants passent par un module API, jamais directement par la base."
                  },
                  {
                    "group": ["drizzle-orm/**", "resend/**", "uploadthing/**"],
                    "message": "Les intégrations externes restent derrière src/api/lib."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/api/modules/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "drizzle-orm": "Utilisez l’adaptateur @/api/lib/db.",
                  "resend": "Utilisez l’adaptateur @/api/lib/resend.",
                  "uploadthing": "Utilisez l’adaptateur @/api/lib/uploadthing."
                },
                "patterns": [
                  {
                    "group": ["drizzle-orm/**", "resend/**", "uploadthing/**"],
                    "message": "Les intégrations externes restent derrière src/api/lib."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/pages/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@/components/admin": "Le plugin public ne doit pas importer l’administration.",
                  "@/db": "Le plugin public passe par un module API pour accéder aux données.",
                  "drizzle-orm": "Utilisez l’adaptateur @/api/lib/db.",
                  "resend": "Utilisez l’adaptateur @/api/lib/resend.",
                  "uploadthing": "Utilisez l’adaptateur @/api/lib/uploadthing."
                },
                "patterns": [
                  {
                    "group": ["@/components/admin/**"],
                    "message": "Le plugin public ne doit pas importer l’administration."
                  },
                  {
                    "group": [
                      "@/db/**",
                      "drizzle-orm/**",
                      "resend/**",
                      "uploadthing/**"
                    ],
                    "message": "Le plugin public passe par les modules API et leurs adaptateurs."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/admin/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@/components/public": "Le plugin admin ne doit pas importer le site public.",
                  "@/db": "Le plugin admin passe par un module API pour accéder aux données.",
                  "drizzle-orm": "Utilisez l’adaptateur @/api/lib/db.",
                  "resend": "Utilisez l’adaptateur @/api/lib/resend.",
                  "uploadthing": "Utilisez l’adaptateur @/api/lib/uploadthing."
                },
                "patterns": [
                  {
                    "group": ["@/components/public/**"],
                    "message": "Le plugin admin ne doit pas importer le site public."
                  },
                  {
                    "group": [
                      "@/db/**",
                      "drizzle-orm/**",
                      "resend/**",
                      "uploadthing/**"
                    ],
                    "message": "Le plugin admin passe par les modules API et leurs adaptateurs."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
