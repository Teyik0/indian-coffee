{
  "name": "indian-coffee",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "dev": "bun --hot src/server.ts",
    "build": "bun node_modules/@teyik0/furin/src/cli/index.ts build --target bun --compile embed",
    "start": "./.furin/build/bun/server",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "smoke": "bun scripts/smoke.ts",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "ci": "biome ci .",
    "verify": "bun run check && bun run typecheck && bun test && bun run build && bun run smoke",
    "doctor": "bun run doctor:public && bun run doctor:admin",
    "doctor:public": "react-doctor . --project ./src/pages --verbose",
    "doctor:admin": "react-doctor . --project ./src/admin --verbose",
    "doctor:diff": "react-doctor . --project ./src/pages,./src/admin --verbose --diff",
    "doctor:json": "react-doctor . --project ./src/pages,./src/admin --json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "seed": "bun scripts/seed.ts",
    "seed:dry": "bun scripts/seed.ts --dry-run",
    "bootstrap:admin": "bun scripts/bootstrap-admin.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@better-auth/drizzle-adapter": "1.6.23",
    "@elysiajs/eden": "1.4.9",
    "@fontsource-variable/fraunces": "5.2.9",
    "@fontsource-variable/source-sans-3": "5.2.9",
    "@formisch/react": "1.0.0-rc.0",
    "@sinclair/typebox": "0.34.52",
    "@teyik0/furin": "0.2.0-alpha.5",
    "better-auth": "1.6.23",
    "bun-plugin-tailwind": "0.1.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.2",
    "elysia": "1.4.29",
    "evlog": "2.22.0",
    "lucide-react": "1.25.0",
    "react": "19.2.7",
    "react-day-picker": "10.0.1",
    "react-dom": "19.2.7",
    "resend": "6.17.2",
    "shadcn": "4.13.1",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "uploadthing": "7.7.4",
    "valibot": "1.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@types/bun": "1.3.14",
    "@types/pg": "^8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "pg": "^8.22.0",
    "react-doctor": "0.8.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2"
  },
  "patchedDependencies": {
    "@teyik0/furin@0.2.0-alpha.5": "patches/@teyik0%2Ffurin@0.2.0-alpha.5.patch"
  }
}
