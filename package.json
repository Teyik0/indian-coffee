{
  "name": "indian-coffee",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "prepare": "if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then lefthook install; fi",
    "fix": "ultracite fix",
    "dev": "bun --hot src/server.ts",
    "build": "furin build --target bun --compile embed",
    "start": "./.furin/build/bun/server",
    "tscheck": "tsc --noEmit",
    "test": "bun test --isolate",
    "doctor": "bunx react-doctor -y --verbose",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:furin": "bun scripts/migrate-furin-sync.ts",
    "db:studio": "drizzle-kit studio",
    "seed": "bun scripts/seed.ts",
    "seed:dry": "bun scripts/seed.ts --dry-run",
    "bootstrap:admin": "bun scripts/bootstrap-admin.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@better-auth/drizzle-adapter": "1.6.23",
    "@elysiajs/eden": "1.4.9",
    "@fontsource-variable/fraunces": "5.2.9",
    "@fontsource-variable/source-sans-3": "5.2.9",
    "@formisch/react": "1.0.0-rc.0",
    "@sinclair/typebox": "0.34.52",
    "@teyik0/furin": "0.3.0-alpha.1",
    "better-auth": "1.6.23",
    "bun-plugin-tailwind": "0.1.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.2",
    "effect4": "npm:effect@4.0.0-beta.102",
    "elysia": "1.4.29",
    "evlog": "2.22.3",
    "lucide-react": "1.25.0",
    "react": "19.2.8",
    "react-day-picker": "10.0.1",
    "react-dom": "19.2.8",
    "resend": "6.17.2",
    "shadcn": "4.13.1",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "uploadthing": "7.7.4",
    "valibot": "1.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/bun": "1.3.14",
    "@types/pg": "^8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "bun": "1.4.0",
    "drizzle-kit": "0.31.10",
    "lefthook": "^2.1.10",
    "pg": "^8.22.0",
    "react-doctor": "0.8.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "ultracite": "7.9.4"
  }
}
